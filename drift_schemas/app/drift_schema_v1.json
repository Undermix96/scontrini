  "fixed_sql": [
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL UNIQUE, \"color\" TEXT NOT NULL DEFAULT '#8E8C9C', \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "receipts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"receipts\" (\"id\" TEXT NOT NULL, \"merchant\" TEXT NULL, \"purchased_at\" INTEGER NULL, \"total_cents\" INTEGER NOT NULL DEFAULT 0, \"currency\" TEXT NOT NULL DEFAULT 'EUR', \"payment_method\" TEXT NULL, \"notes\" TEXT NULL, \"ai_model\" TEXT NULL, \"ai_raw\" TEXT NULL, \"dismissed_warnings\" TEXT NOT NULL DEFAULT '[]', \"duplicate_of\" TEXT NULL REFERENCES receipts (id) ON DELETE SET NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "receipt_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"receipt_items\" (\"id\" TEXT NOT NULL, \"receipt_id\" TEXT NOT NULL REFERENCES receipts (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL DEFAULT 0, \"description\" TEXT NOT NULL, \"quantity\" REAL NULL, \"unit_price_cents\" INTEGER NULL, \"total_cents\" INTEGER NOT NULL DEFAULT 0, \"category_id\" INTEGER NULL REFERENCES categories (id) ON DELETE SET NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    }
